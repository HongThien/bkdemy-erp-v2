  {"stt":38,"muc":"9.1","dang":"T107010401","loai":"tu_luan","nd":"Tính: $0,2 + \\dfrac{3}{5} : \\dfrac{-3}{2}$",
   "lg":"$0,2 + \\dfrac{3}{5} : \\dfrac{-3}{2}$\n$= \\dfrac{1}{5} + \\dfrac{3}{5} \\cdot \\dfrac{-2}{3}$\n$= \\dfrac{1}{5} + \\dfrac{-2}{5}$\n$= \\dfrac{-1}{5}$"},
  {"stt":39,"muc":"9.2","dang":"T107010207","loai":"tu_luan","nd":"Tính: $4,1 \\cdot \\dfrac{-5}{12} - 6,2 + 4,1 \\cdot \\dfrac{-7}{12}$",
   "lg":"$4,1 \\cdot \\dfrac{-5}{12} - 6,2 + 4,1 \\cdot \\dfrac{-7}{12}$\n$= 4,1 \\cdot \\left(\\dfrac{-5}{12} + \\dfrac{-7}{12}\\right) - 6,2$\n$= 4,1 \\cdot (-1) - 6,2$\n$= -4,1 - 6,2$\n$= -10,3$"},
  {"stt":40,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $\\left(\\dfrac{-1}{2}\\right)^2 - \\dfrac{3}{125} : (0,2)^3 - \\dfrac{5}{6} \\cdot (-12) + 2022^0$",
   "lg":"$\\left(\\dfrac{-1}{2}\\right)^2 - \\dfrac{3}{125} : (0,2)^3 - \\dfrac{5}{6} \\cdot (-12) + 2022^0$\n$= \\dfrac{1}{4} - \\dfrac{3}{125} : \\dfrac{1}{125} - (-10) + 1$\n$= \\dfrac{1}{4} - 3 + 10 + 1$\n$= \\dfrac{1}{4} + 8$\n$= \\dfrac{33}{4}$"},
  {"stt":41,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $\\left(\\dfrac{-1}{3}\\right)^2 - \\dfrac{3}{8} : (0,5)^3 - \\dfrac{5}{2} \\cdot (-4) + 2022^0$",
   "lg":"$\\left(\\dfrac{-1}{3}\\right)^2 - \\dfrac{3}{8} : (0,5)^3 - \\dfrac{5}{2} \\cdot (-4) + 2022^0$\n$= \\dfrac{1}{9} - \\dfrac{3}{8} : \\dfrac{1}{8} - (-10) + 1$\n$= \\dfrac{1}{9} - 3 + 10 + 1$\n$= \\dfrac{1}{9} + 8$\n$= \\dfrac{73}{9}$"},
  {"stt":42,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $(-5,4)^0 + \\dfrac{(-3^3)^2}{10} : \\left[\\dfrac{13}{3} - \\left(\\dfrac{13}{3} - \\dfrac{9}{2}\\right)\\right]^3$",
   "lg":"$(-5,4)^0 + \\dfrac{(-3^3)^2}{10} : \\left[\\dfrac{13}{3} - \\left(\\dfrac{13}{3} - \\dfrac{9}{2}\\right)\\right]^3$\n$= 1 + \\dfrac{(-27)^2}{10} : \\left[\\dfrac{13}{3} - \\dfrac{13}{3} + \\dfrac{9}{2}\\right]^3$\n$= 1 + \\dfrac{729}{10} : \\left(\\dfrac{9}{2}\\right)^3$\n$= 1 + \\dfrac{729}{10} : \\dfrac{729}{8}$\n$= 1 + \\dfrac{729}{10} \\cdot \\dfrac{8}{729}$\n$= 1 + \\dfrac{4}{5}$\n$= \\dfrac{9}{5}$"},
  {"stt":43,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $0,25 : \\left\\{\\dfrac{1}{2} - 8 \\cdot \\left(\\dfrac{1}{4} - \\dfrac{3}{2}\\right)^2\\right\\}$",
   "lg":"$0,25 : \\left\\{\\dfrac{1}{2} - 8 \\cdot \\left(\\dfrac{1}{4} - \\dfrac{3}{2}\\right)^2\\right\\}$\n$= \\dfrac{1}{4} : \\left\\{\\dfrac{1}{2} - 8 \\cdot \\left(\\dfrac{-5}{4}\\right)^2\\right\\}$\n$= \\dfrac{1}{4} : \\left\\{\\dfrac{1}{2} - 8 \\cdot \\dfrac{25}{16}\\right\\}$\n$= \\dfrac{1}{4} : \\left\\{\\dfrac{1}{2} - \\dfrac{25}{2}\\right\\}$\n$= \\dfrac{1}{4} : (-12)$\n$= \\dfrac{-1}{48}$"},
  {"stt":44,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $0,25 + \\dfrac{4}{5} : \\dfrac{16}{15} + \\left(\\dfrac{-2023}{2022}\\right)^0$",
   "lg":"$0,25 + \\dfrac{4}{5} : \\dfrac{16}{15} + \\left(\\dfrac{-2023}{2022}\\right)^0$\n$= \\dfrac{1}{4} + \\dfrac{4}{5} \\cdot \\dfrac{15}{16} + 1$\n$= \\dfrac{1}{4} + \\dfrac{3}{4} + 1$\n$= 2$"},
  {"stt":45,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $5 - \\left(-\\dfrac{9}{11}\\right)^0 + \\left(\\dfrac{1}{3}\\right)^3 \\cdot 81$",
   "lg":"$5 - \\left(-\\dfrac{9}{11}\\right)^0 + \\left(\\dfrac{1}{3}\\right)^3 \\cdot 81$\n$= 5 - 1 + \\dfrac{1}{27} \\cdot 81$\n$= 4 + 3$\n$= 7$"},
  {"stt":46,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $\\dfrac{5}{4} \\cdot 3\\dfrac{2}{7} - 1,25 : \\dfrac{7}{9} - 0,75$",
   "lg":"$\\dfrac{5}{4} \\cdot 3\\dfrac{2}{7} - 1,25 : \\dfrac{7}{9} - 0,75$\n$= \\dfrac{5}{4} \\cdot \\dfrac{23}{7} - \\dfrac{5}{4} \\cdot \\dfrac{9}{7} - \\dfrac{3}{4}$\n$= \\dfrac{5}{4} \\cdot \\left(\\dfrac{23}{7} - \\dfrac{9}{7}\\right) - \\dfrac{3}{4}$\n$= \\dfrac{5}{4} \\cdot 2 - \\dfrac{3}{4}$\n$= \\dfrac{10}{4} - \\dfrac{3}{4}$\n$= \\dfrac{7}{4}$"},
  {"stt":47,"muc":"9.2","dang":"T107010401","loai":"tu_luan","nd":"Tính: $\\left(\\dfrac{-3}{7}\\right)^2 : \\left(\\dfrac{-1}{7}\\right)^2 + (-2)^3 \\cdot \\dfrac{1}{8} - (-2023)^0$",
   "lg":"$\\left(\\dfrac{-3}{7}\\right)^2 : \\left(\\dfrac{-1}{7}\\right)^2 + (-2)^3 \\cdot \\dfrac{1}{8} - (-2023)^0$\n$= \\dfrac{9}{49} : \\dfrac{1}{49} + (-8) \\cdot \\dfrac{1}{8} - 1$\n$= 9 - 1 - 1$\n$= 7$"},
  {"stt":48,"muc":"9.2","dang":"07702220320302","loai":"tu_luan","nd":"Tính: $\\left(0,(3) + \\dfrac{|-2|}{3}\\right) : \\dfrac{\\sqrt{25}}{4} - \\left(2^3 + 3^2\\right)^0$","da":"$-\\dfrac{1}{5}$",
   "lg":"$0,(3) = \\dfrac{1}{3}$; $|-2| = 2$; $\\sqrt{25} = 5$; $\\left(2^3 + 3^2\\right)^0 = 1$\n$\\left(\\dfrac{1}{3} + \\dfrac{2}{3}\\right) : \\dfrac{5}{4} - 1$\n$= 1 \\cdot \\dfrac{4}{5} - 1$\n$= \\dfrac{4}{5} - 1$\n$= \\dfrac{-1}{5}$"},
  {"stt":49,"muc":"9.2","dang":"07702220320302","loai":"tu_luan","nd":"Tính: $\\left(\\dfrac{-3}{2}\\right)^2 - \\left(0,9 : \\dfrac{3}{10} + \\sqrt{225} \\cdot \\left|\\dfrac{-1}{12}\\right|\\right)$","da":"$-2$",
   "lg":"$\\left(\\dfrac{-3}{2}\\right)^2 - \\left(0,9 : \\dfrac{3}{10} + \\sqrt{225} \\cdot \\left|\\dfrac{-1}{12}\\right|\\right)$\n$= \\dfrac{9}{4} - \\left(\\dfrac{9}{10} \\cdot \\dfrac{10}{3} + 15 \\cdot \\dfrac{1}{12}\\right)$\n$= \\dfrac{9}{4} - \\left(3 + \\dfrac{5}{4}\\right)$\n$= \\dfrac{9}{4} - \\dfrac{17}{4}$\n$= -2$"},
  {"stt":50,"muc":"9.2","dang":"T107010206","loai":"tu_luan","nd":"Tính: $2,56 - \\dfrac{4}{9} - \\left(7,56 - \\dfrac{13}{9}\\right)$",
   "lg":"$2,56 - \\dfrac{4}{9} - \\left(7,56 - \\dfrac{13}{9}\\right)$\n$= 2,56 - \\dfrac{4}{9} - 7,56 + \\dfrac{13}{9}$\n$= (2,56 - 7,56) + \\left(\\dfrac{13}{9} - \\dfrac{4}{9}\\right)$\n$= -5 + 1$\n$= -4$"},
  {"stt":51,"muc":"9.3","dang":"T107010206","loai":"tu_luan","nd":"Tính thuận tiện: $-\\dfrac{19}{13} + \\dfrac{2}{11} + \\dfrac{19}{13}$",
   "lg":"$-\\dfrac{19}{13} + \\dfrac{2}{11} + \\dfrac{19}{13}$\n$= \\left(-\\dfrac{19}{13} + \\dfrac{19}{13}\\right) + \\dfrac{2}{11}$\n$= 0 + \\dfrac{2}{11}$\n$= \\dfrac{2}{11}$"},
  {"stt":52,"muc":"9.3","dang":"T107010206","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{23}{7} + \\dfrac{4}{3} - \\dfrac{9}{7} + \\dfrac{10}{6}$",
   "lg":"$\\dfrac{23}{7} + \\dfrac{4}{3} - \\dfrac{9}{7} + \\dfrac{10}{6}$\n$= \\left(\\dfrac{23}{7} - \\dfrac{9}{7}\\right) + \\left(\\dfrac{4}{3} + \\dfrac{5}{3}\\right)$\n$= 2 + 3$\n$= 5$"},
  {"stt":53,"muc":"9.3","dang":"T107010206","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{8}{5} + \\dfrac{4}{7} + \\dfrac{-8}{5}$",
   "lg":"$\\dfrac{8}{5} + \\dfrac{4}{7} + \\dfrac{-8}{5}$\n$= \\left(\\dfrac{8}{5} + \\dfrac{-8}{5}\\right) + \\dfrac{4}{7}$\n$= 0 + \\dfrac{4}{7}$\n$= \\dfrac{4}{7}$"},
  {"stt":54,"muc":"9.3","dang":"T107010206","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{3}{10} + \\dfrac{7}{8} + \\dfrac{-3}{10}$",
   "lg":"$\\dfrac{3}{10} + \\dfrac{7}{8} + \\dfrac{-3}{10}$\n$= \\left(\\dfrac{3}{10} + \\dfrac{-3}{10}\\right) + \\dfrac{7}{8}$\n$= 0 + \\dfrac{7}{8}$\n$= \\dfrac{7}{8}$"},
  {"stt":55,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\left(\\dfrac{-5}{9}\\right) \\cdot \\dfrac{3}{11} + \\left(\\dfrac{-4}{9}\\right) \\cdot \\dfrac{3}{11}$",
   "lg":"$\\left(\\dfrac{-5}{9}\\right) \\cdot \\dfrac{3}{11} + \\left(\\dfrac{-4}{9}\\right) \\cdot \\dfrac{3}{11}$\n$= \\dfrac{3}{11} \\cdot \\left(\\dfrac{-5}{9} + \\dfrac{-4}{9}\\right)$\n$= \\dfrac{3}{11} \\cdot (-1)$\n$= \\dfrac{-3}{11}$"},
  {"stt":56,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{5}{12} \\cdot \\left(-\\dfrac{3}{4}\\right) + \\dfrac{7}{12} \\cdot \\left(-\\dfrac{3}{4}\\right)$",
   "lg":"$\\dfrac{5}{12} \\cdot \\left(-\\dfrac{3}{4}\\right) + \\dfrac{7}{12} \\cdot \\left(-\\dfrac{3}{4}\\right)$\n$= \\left(-\\dfrac{3}{4}\\right) \\cdot \\left(\\dfrac{5}{12} + \\dfrac{7}{12}\\right)$\n$= \\left(-\\dfrac{3}{4}\\right) \\cdot 1$\n$= -\\dfrac{3}{4}$"},
  {"stt":57,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $3\\dfrac{2}{3} \\cdot \\dfrac{-2}{5} + 1\\dfrac{1}{3} \\cdot \\dfrac{-2}{5}$",
   "lg":"$3\\dfrac{2}{3} \\cdot \\dfrac{-2}{5} + 1\\dfrac{1}{3} \\cdot \\dfrac{-2}{5}$\n$= \\dfrac{-2}{5} \\cdot \\left(3\\dfrac{2}{3} + 1\\dfrac{1}{3}\\right)$\n$= \\dfrac{-2}{5} \\cdot 5$\n$= -2$"},
  {"stt":58,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{-3}{8} \\cdot \\dfrac{1}{9} + \\dfrac{1}{9} \\cdot \\dfrac{-13}{8}$",
   "lg":"$\\dfrac{-3}{8} \\cdot \\dfrac{1}{9} + \\dfrac{1}{9} \\cdot \\dfrac{-13}{8}$\n$= \\dfrac{1}{9} \\cdot \\left(\\dfrac{-3}{8} + \\dfrac{-13}{8}\\right)$\n$= \\dfrac{1}{9} \\cdot (-2)$\n$= \\dfrac{-2}{9}$"},
  {"stt":59,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{8}{3} \\cdot \\dfrac{-5}{16} + \\dfrac{8}{3} : \\dfrac{-16}{11}$",
   "lg":"$\\dfrac{8}{3} \\cdot \\dfrac{-5}{16} + \\dfrac{8}{3} : \\dfrac{-16}{11}$\n$= \\dfrac{8}{3} \\cdot \\dfrac{-5}{16} + \\dfrac{8}{3} \\cdot \\dfrac{-11}{16}$\n$= \\dfrac{8}{3} \\cdot \\left(\\dfrac{-5}{16} + \\dfrac{-11}{16}\\right)$\n$= \\dfrac{8}{3} \\cdot (-1)$\n$= \\dfrac{-8}{3}$"},
  {"stt":60,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{-17}{15} : \\dfrac{12}{31} - \\dfrac{31}{12} + \\dfrac{-13}{15} \\cdot \\dfrac{31}{12}$",
   "lg":"$\\dfrac{-17}{15} : \\dfrac{12}{31} - \\dfrac{31}{12} + \\dfrac{-13}{15} \\cdot \\dfrac{31}{12}$\n$= \\dfrac{-17}{15} \\cdot \\dfrac{31}{12} - \\dfrac{31}{12} \\cdot 1 + \\dfrac{-13}{15} \\cdot \\dfrac{31}{12}$\n$= \\dfrac{31}{12} \\cdot \\left(\\dfrac{-17}{15} - 1 + \\dfrac{-13}{15}\\right)$\n$= \\dfrac{31}{12} \\cdot \\left(\\dfrac{-30}{15} - 1\\right)$\n$= \\dfrac{31}{12} \\cdot (-3)$\n$= \\dfrac{-31}{4}$"},
  {"stt":61,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\dfrac{1}{7} \\cdot \\dfrac{-3}{8} + \\dfrac{-13}{8} \\cdot \\dfrac{1}{7}$",
   "lg":"$\\dfrac{1}{7} \\cdot \\dfrac{-3}{8} + \\dfrac{-13}{8} \\cdot \\dfrac{1}{7}$\n$= \\dfrac{1}{7} \\cdot \\left(\\dfrac{-3}{8} + \\dfrac{-13}{8}\\right)$\n$= \\dfrac{1}{7} \\cdot (-2)$\n$= \\dfrac{-2}{7}$"},
  {"stt":62,"muc":"9.4","dang":"T107010207","loai":"tu_luan","nd":"Tính thuận tiện: $\\left(\\dfrac{1}{5} - \\dfrac{5}{7}\\right) : \\dfrac{7}{11} + \\left(\\dfrac{4}{5} - \\dfrac{2}{7}\\right) : \\dfrac{7}{11}$",
   "lg":"$\\left(\\dfrac{1}{5} - \\dfrac{5}{7}\\right) : \\dfrac{7}{11} + \\left(\\dfrac{4}{5} - \\dfrac{2}{7}\\right) : \\dfrac{7}{11}$\n$= \\left[\\left(\\dfrac{1}{5} - \\dfrac{5}{7}\\right) + \\left(\\dfrac{4}{5} - \\dfrac{2}{7}\\right)\\right] : \\dfrac{7}{11}$\n$= \\left[\\left(\\dfrac{1}{5} + \\dfrac{4}{5}\\right) - \\left(\\dfrac{5}{7} + \\dfrac{2}{7}\\right)\\right] : \\dfrac{7}{11}$\n$= (1 - 1) : \\dfrac{7}{11}$\n$= 0$"},
  {"stt":63,"muc":"9.5","dang":"T107010302","loai":"tu_luan","nd":"Rút gọn: $\\dfrac{2^4 \\cdot 2^6}{(2^5)^2} \\cdot 2023$","da":"$2023$",
   "lg":"$\\dfrac{2^4 \\cdot 2^6}{(2^5)^2} \\cdot 2023$\n$= \\dfrac{2^{10}}{2^{10}} \\cdot 2023$\n$= 1 \\cdot 2023$\n$= 2023$"},
