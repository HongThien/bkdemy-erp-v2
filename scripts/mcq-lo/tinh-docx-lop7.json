  {"stt":29,"muc":"9.1","dang":"07702202202","loai":"tu_luan","nd":"Tính: $\\sqrt{16} + \\dfrac{9}{4} : \\left(\\dfrac{1}{4} + 1,25\\right)$","da":"$\\dfrac{11}{2}$",
   "lg":"$\\sqrt{16} + \\dfrac{9}{4} : \\left(\\dfrac{1}{4} + 1,25\\right)$\n$= 4 + \\dfrac{9}{4} : \\left(\\dfrac{1}{4} + \\dfrac{5}{4}\\right)$\n$= 4 + \\dfrac{9}{4} : \\dfrac{3}{2}$\n$= 4 + \\dfrac{9}{4} \\cdot \\dfrac{2}{3}$\n$= 4 + \\dfrac{3}{2}$\n$= \\dfrac{11}{2}$"},
  {"stt":30,"muc":"9.1","dang":"07702202202","loai":"tu_luan","nd":"Tính: $\\sqrt{9} + \\dfrac{5}{6} : \\left(\\dfrac{1}{5} + 0,3\\right)$","da":"$\\dfrac{14}{3}$",
   "lg":"$\\sqrt{9} + \\dfrac{5}{6} : \\left(\\dfrac{1}{5} + 0,3\\right)$\n$= 3 + \\dfrac{5}{6} : \\left(\\dfrac{2}{10} + \\dfrac{3}{10}\\right)$\n$= 3 + \\dfrac{5}{6} : \\dfrac{1}{2}$\n$= 3 + \\dfrac{5}{3}$\n$= \\dfrac{14}{3}$"},
