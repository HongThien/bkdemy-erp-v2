  {"stt":28,"muc":"9.1","dang":"T107010401","loai":"tu_luan","nd":"Tính: $\\dfrac{-1}{7} + \\dfrac{6}{7} \\cdot \\left(0,5 - \\dfrac{1}{3}\\right)$",
