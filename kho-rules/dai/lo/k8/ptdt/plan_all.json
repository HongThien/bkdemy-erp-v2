{
 "T108030105018": {
  "ly_do": [
   "SỬA ĐỀ (khoảng cách 2); đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 1)(3x + 5)(3x - 1)$",
  "loi_giai": "Đặt $A = 9x^3 + 3x^2 - 17x + 5$.\nNhẩm thấy:\n$A(1) = 9 + 3 - 17 + 5 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 1)$.\nTa có:\n$A = 9x^3 - 9x^2 + 12x^2 - 12x - 5x + 5$\n$= 9x^2(x - 1) + 12x(x - 1) - 5(x - 1)$\n$= (x - 1)(9x^2 + 12x - 5)$\n$= (x - 1)(9x^2 + 15x - 3x - 5)$\n$= (x - 1)[3x(3x + 5) - (3x + 5)]$\n$= (x - 1)(3x + 5)(3x - 1)$.\nVậy $A = (x - 1)(3x + 5)(3x - 1)$.",
  "noi_dung": "Phân tích đa thức $9x^3 + 3x^2 - 17x + 5$ thành nhân tử bằng phương pháp nhẩm nghiệm."
 },
 "T108030105019": {
  "ly_do": [
   "SỬA ĐỀ (khoảng cách 2); đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 1)(5x - 1)(2x + 3)$",
  "loi_giai": "Đặt $A = 10x^3 + 3x^2 - 16x + 3$.\nNhẩm thấy:\n$A(1) = 10 + 3 - 16 + 3 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 1)$.\nTa có:\n$A = 10x^3 - 10x^2 + 13x^2 - 13x - 3x + 3$\n$= 10x^2(x - 1) + 13x(x - 1) - 3(x - 1)$\n$= (x - 1)(10x^2 + 13x - 3)$\n$= (x - 1)(10x^2 - 2x + 15x - 3)$\n$= (x - 1)[2x(5x - 1) + 3(5x - 1)]$\n$= (x - 1)(5x - 1)(2x + 3)$.\nVậy $A = (x - 1)(5x - 1)(2x + 3)$.",
  "noi_dung": "Phân tích đa thức $10x^3 + 3x^2 - 16x + 3$ thành nhân tử bằng phương pháp nhẩm nghiệm."
 },
 "T108030105020": {
  "ly_do": [
   "GIỮ ĐỀ (hợp lệ), viết lại lời giải; đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 1)(4x + 7)(2x - 1)$",
  "loi_giai": "Đặt $A = 8x^3 + 2x^2 - 17x + 7$.\nNhẩm thấy:\n$A(1) = 8 + 2 - 17 + 7 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 1)$.\nTa có:\n$A = 8x^3 - 8x^2 + 10x^2 - 10x - 7x + 7$\n$= 8x^2(x - 1) + 10x(x - 1) - 7(x - 1)$\n$= (x - 1)(8x^2 + 10x - 7)$\n$= (x - 1)(8x^2 + 14x - 4x - 7)$\n$= (x - 1)[2x(4x + 7) - (4x + 7)]$\n$= (x - 1)(4x + 7)(2x - 1)$.\nVậy $A = (x - 1)(4x + 7)(2x - 1)$."
 },
 "T108030105022": {
  "ly_do": [
   "SỬA ĐỀ (khoảng cách 5); đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 1)(6x - 1)(x + 2)$",
  "loi_giai": "Đặt $A = 6x^3 + 5x^2 - 13x + 2$.\nNhẩm thấy:\n$A(1) = 6 + 5 - 13 + 2 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 1)$.\nTa có:\n$A = 6x^3 - 6x^2 + 11x^2 - 11x - 2x + 2$\n$= 6x^2(x - 1) + 11x(x - 1) - 2(x - 1)$\n$= (x - 1)(6x^2 + 11x - 2)$\n$= (x - 1)(6x^2 - x + 12x - 2)$\n$= (x - 1)[x(6x - 1) + 2(6x - 1)]$\n$= (x - 1)(6x - 1)(x + 2)$.\nVậy $A = (x - 1)(6x - 1)(x + 2)$.",
  "noi_dung": "Phân tích đa thức $6x^3 + 5x^2 - 13x + 2$ thành nhân tử bằng phương pháp nhẩm nghiệm."
 },
 "T108030105027": {
  "ly_do": [
   "GIỮ ĐỀ (hợp lệ), viết lại lời giải; đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 2)(3x - 2)(2x + 3)$",
  "loi_giai": "Đặt $A = 6x^3 - 7x^2 - 16x + 12$.\nNhẩm thấy:\n$A(2) = 6 \\cdot 2^3 - 7 \\cdot 2^2 - 16 \\cdot 2 + 12 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 2)$.\nTa có:\n$A = 6x^3 - 12x^2 + 5x^2 - 10x - 6x + 12$\n$= 6x^2(x - 2) + 5x(x - 2) - 6(x - 2)$\n$= (x - 2)(6x^2 + 5x - 6)$\n$= (x - 2)(6x^2 - 4x + 9x - 6)$\n$= (x - 2)[2x(3x - 2) + 3(3x - 2)]$\n$= (x - 2)(3x - 2)(2x + 3)$.\nVậy $A = (x - 2)(3x - 2)(2x + 3)$."
 },
 "T108030105030": {
  "ly_do": [
   "GIỮ ĐỀ (hợp lệ), viết lại lời giải; đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x - 1)(x - 1)(4x + 5)$",
  "loi_giai": "Đặt $A = 4x^3 - 3x^2 - 6x + 5$.\nNhẩm thấy:\n$A(1) = 4 - 3 - 6 + 5 = 0$.\nVậy ta hướng tới tạo nhân tử $(x - 1)$.\nTa có:\n$A = 4x^3 - 4x^2 + x^2 - x - 5x + 5$\n$= 4x^2(x - 1) + x(x - 1) - 5(x - 1)$\n$= (x - 1)(4x^2 + x - 5)$\n$= (x - 1)(4x^2 - 4x + 5x - 5)$\n$= (x - 1)[4x(x - 1) + 5(x - 1)]$\n$= (x - 1)(x - 1)(4x + 5)$.\nVậy $A = (x - 1)(x - 1)(4x + 5)$."
 },
 "T108030105051": {
  "ly_do": [
   "SỬA ĐỀ (khoảng cách 2); đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x + 1)(2x - 1)(2x - 5)$",
  "loi_giai": "Đặt $A = 4x^3 - 8x^2 - 7x + 5$.\nNhẩm thấy:\n$A(-1) = 4 \\cdot (-1)^3 - 8 \\cdot (-1)^2 - 7 \\cdot (-1) + 5 = 0$.\nVậy ta hướng tới tạo nhân tử $(x + 1)$.\nTa có:\n$A = 4x^3 + 4x^2 - 12x^2 - 12x + 5x + 5$\n$= 4x^2(x + 1) - 12x(x + 1) + 5(x + 1)$\n$= (x + 1)(4x^2 - 12x + 5)$\n$= (x + 1)(4x^2 - 2x - 10x + 5)$\n$= (x + 1)[2x(2x - 1) - 5(2x - 1)]$\n$= (x + 1)(2x - 1)(2x - 5)$.\nVậy $A = (x + 1)(2x - 1)(2x - 5)$.",
  "noi_dung": "Phân tích đa thức $4x^3 - 8x^2 - 7x + 5$ thành nhân tử bằng phương pháp nhẩm nghiệm."
 },
 "T108030105054": {
  "ly_do": [
   "GIỮ ĐỀ (hợp lệ), viết lại lời giải; đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x + 1)(5x - 6)(2x + 1)$",
  "loi_giai": "Đặt $A = 10x^3 + 3x^2 - 13x - 6$.\nNhẩm thấy:\n$A(-1) = 10 \\cdot (-1)^3 + 3 \\cdot (-1)^2 - 13 \\cdot (-1) - 6 = 0$.\nVậy ta hướng tới tạo nhân tử $(x + 1)$.\nTa có:\n$A = 10x^3 + 10x^2 - 7x^2 - 7x - 6x - 6$\n$= 10x^2(x + 1) - 7x(x + 1) - 6(x + 1)$\n$= (x + 1)(10x^2 - 7x - 6)$\n$= (x + 1)(10x^2 - 12x + 5x - 6)$\n$= (x + 1)[2x(5x - 6) + (5x - 6)]$\n$= (x + 1)(5x - 6)(2x + 1)$.\nVậy $A = (x + 1)(5x - 6)(2x + 1)$."
 },
 "T108030105055": {
  "ly_do": [
   "GIỮ ĐỀ (hợp lệ), viết lại lời giải; đáp án + lời giải viết lại theo đề"
  ],
  "dap_an": "$(x + 1)(3x - 2)(2x + 1)$",
  "loi_giai": "Đặt $A = 6x^3 + 5x^2 - 3x - 2$.\nNhẩm thấy:\n$A(-1) = 6 \\cdot (-1)^3 + 5 \\cdot (-1)^2 - 3 \\cdot (-1) - 2 = 0$.\nVậy ta hướng tới tạo nhân tử $(x + 1)$.\nTa có:\n$A = 6x^3 + 6x^2 - x^2 - x - 2x - 2$\n$= 6x^2(x + 1) - x(x + 1) - 2(x + 1)$\n$= (x + 1)(6x^2 - x - 2)$\n$= (x + 1)(6x^2 - 4x + 3x - 2)$\n$= (x + 1)[2x(3x - 2) + (3x - 2)]$\n$= (x + 1)(3x - 2)(2x + 1)$.\nVậy $A = (x + 1)(3x - 2)(2x + 1)$."
 },
 "T108030105056": {
