 "T108030602084": {
  "ly_do": [
   "ĐÁP ÁN sai dấu: 3x+5=0 ⇒ x = −5/3"
  ],
  "dap_an": "$x = 5; x = -\\dfrac{5}{3}$",
  "loi_giai": "$2x(x-5) + x^2 - 25 = 0$\n$2x(x-5) + (x-5)(x+5) = 0$\n$(x-5)(3x+5) = 0$\nTrường hợp 1:\n$x - 5 = 0$\n$x = 5$\nTrường hợp 2:\n$3x + 5 = 0$\n$x = -\\dfrac{5}{3}$\nVậy:\n$x = 5; x = -\\dfrac{5}{3}$"
 },
 "T108030603043": {
  "ly_do": [
   "ĐÁP ÁN + lời giải sai: x²−2x−3=0 ⇒ (x−3)(x+1) ⇒ x=3 hoặc x=−1"
  ],
  "dap_an": "x=3; x=-1",
  "loi_giai": "$4 - x^2 + 2x - 1 = 0$\n$-x^2 + 2x + 3 = 0$\n$x^2 - 2x - 3 = 0$\n$x^2 - 3x + x - 3 = 0$\n$x(x - 3) + (x - 3) = 0$\n$(x - 3)(x + 1) = 0$\nTrường hợp 1:\n$x - 3 = 0$\n$x = 3$\nTrường hợp 2:\n$x + 1 = 0$\n$x = -1$\nVậy:\n$x = 3; x = -1$"
 },
 "T108030601001": {
  "ly_do": [
   "ĐÁP ÁN + lời giải sai: x³−7x+6=(x−1)(x−2)(x+3)"
  ],
  "dap_an": "$x = -3; x = 1; x = 2$",
  "loi_giai": "Nhẩm thấy:\n$1^3 - 7 \\cdot 1 + 6 = 0$\nVậy đa thức có nhân tử $(x-1)$.\nTa có:\n$x^3 - 7x + 6 = x^3 - x^2 + x^2 - x - 6x + 6$\n$= x^2(x-1) + x(x-1) - 6(x-1)$\n$= (x-1)(x^2 + x - 6)$\n$= (x-1)(x-2)(x+3)$\nDo đó:\nTrường hợp 1:\n$x - 1 = 0$\n$x = 1$\nTrường hợp 2:\n$x - 2 = 0$\n$x = 2$\nTrường hợp 3:\n$x + 3 = 0$\n$x = -3$\nVậy:\n$x = -3; x = 1; x = 2$"
 },
 "T108030601007": {
  "ly_do": [
   "ĐỀ sai: x³+3x²+3x+2 không có dạng (x+1)³ (nghiệm không nguyên) → sửa đề thành x³+3x²+3x+1"
  ],
  "noi_dung": "$x^3 + 3x^2 + 3x + 1 = 0$",
  "loi_giai": "Nhẩm thấy:\n$(-1)^3 + 3(-1)^2 + 3(-1) + 1 = 0$\nVậy đa thức có nhân tử $(x+1)$.\nTa có:\n$x^3 + 3x^2 + 3x + 1 = x^3 + x^2 + 2x^2 + 2x + x + 1$\n$= x^2(x + 1) + 2x(x + 1) + (x + 1)$\n$= (x + 1)(x^2 + 2x + 1)$\n$= (x + 1)(x + 1)^2$\n$= (x + 1)^3$\nDo đó:\n$(x + 1)^3 = 0$\nTrường hợp 1:\n$x + 1 = 0$\n$x = -1$\nVậy:\n$x = -1$"
 },
 "T108030601008": {
  "ly_do": [
   "ĐÁP ÁN thiếu nghiệm −2: (x+1)²(x+2)=0"
  ],
  "dap_an": "$x = -2; x = -1$"
 },
