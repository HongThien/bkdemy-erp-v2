[
 {
  "ma_cau": "T108030603043",
  "loai": "tra_loi_ngan",
  "de": "Giải phương trình:\n$4 - x^2 + 2x - 1 = 0$",
  "dap_an": "x=1; x=3",
  "loi_giai": "$4 - x^2 + 2x - 1 = 0$\n$-x^2 + 2x + 3 = 0$\n$x^2 - 2x - 3 = 0$\n$x^2 - x - 3x + 3 = 0$\n$x(x - 1) - 3(x - 1) = 0$\n$(x - 1)(x - 3) = 0$\nTrường hợp 1:\n$x - 1 = 0$\n$x = 1$\nTrường hợp 2:\n$x - 3 = 0$\n$x = 3$\nVậy:\n$x = 1; x = 3$"
 },
 {
  "ma_cau": "T108030603055",
  "loai": "tra_loi_ngan",
  "de": "$x^3 - 3x^2 - x + 3 = 0$",
  "dap_an": "$x = -1; x = 1; x = 3$",
  "loi_giai": "Nhẩm thấy:\n$1^3 - 3 \\cdot 1^2 - 1 + 3 = 0$\nVậy đa thức có nhân tử $(x-1)$.\nTa có:\n$x^3 - 3x^2 - x + 3 = x^3 - x^2 - 2x^2 + 2x - 3x + 3$\n$= x^2(x - 1) - 2x(x - 1) - 3(x - 1)$\n$= (x - 1)(x^2 - 2x - 3)$\n$= (x - 1)(x - 3)(x + 1)$\nDo đó:\n$(x - 1)(x - 3)(x + 1) = 0$\nTrường hợp 1:\n$x - 1 = 0$\n$x = 1$\nTrường hợp 2:\n$x - 3 = 0$\n$x = 3$\nTrường hợp 3:\n$x + 1 = 0$\n$x = -1$\nVậy:\n$x = -1; x = 1; x = 3$"
 },
 {
  "ma_cau": "T108030302001",
  "loai": "tra_loi_ngan",
  "de": "Giải phương trình $x^3-3x^2-4x+12=0$.",
  "dap_an": "{-2;2;3}",
  "loi_giai": "$x^3 - 3x^2 - 4x + 12 = 0$\n$x^2(x - 3) - 4(x - 3) = 0$\n$(x - 3)(x^2 - 4) = 0$\n$(x - 3)(x - 2)(x + 2) = 0$\nTrường hợp 1:\n$x - 3 = 0$\n$x = 3$\nTrường hợp 2:\n$x - 2 = 0$\n$x = 2$\nTrường hợp 3:\n$x + 2 = 0$\n$x = -2$\nVậy\n$x \\in \\{-2; 2; 3\\}$."
 },
