 },
 {
  "ma_cau": "T108010302044",
  "loai": "tra_loi_ngan",
  "de": "$-2x^2y(3xy^2-4yz+5xz^2)$",
  "dap_an": "-6x^3y^3+8x^2y^2z-10x^3yz^2",
  "loi_giai": "$-2x^2y(3xy^2-4yz+5xz^2) = -6x^3y^3+8x^2y^2z-10x^3yz^2$"
 },
 {
  "ma_cau": "T108020203062",
  "loai": "tra_loi_ngan",
  "de": "Cho các số x, y thỏa mãn $2x^2 +10y^2-6xy-6x-2y+10=0$.\nTính giá trị của biểu thức $A = \\dfrac{(x+y-3)^{2025}-y^{2025}}{x}$.",
  "dap_an": "0",
  "loi_giai": "Từ giả thiết:\n$2x^2 +10y^2-6xy-6x-2y+10=0$.\nTa có:\n$2x^2 +10y^2-6xy-6x-2y+10=\\dfrac{1}{2}(2x-3y-3)^2+\\dfrac{11}{2}(y-1)^2$.\nDo đó:\n$\\dfrac{1}{2}(2x-3y-3)^2+\\dfrac{11}{2}(y-1)^2 = 0$.\nVì các số hạng đều không âm nên $2x-3y-3=0$ và $y-1=0$.\nSuy ra $y=1$ và $x=3$.\nKhi đó:\n$A = \\dfrac{(3+1-3)^{2025}-1^{2025}}{3} = \\dfrac{1-1}{3} = 0$.\nVậy $A = 0$."
 },
 {
  "ma_cau": "T108020401001",
  "loai": "tra_loi_ngan",
  "de": "Hoàn thành biểu thức $9x^2 - 16 = \\ldots$",
  "dap_an": "$(3x+4)(3x-4)$",
  "loi_giai": "$9x^2 - 16 = (3x+4)(3x-4)$"
 },
 {
  "ma_cau": "T108020203001",
  "loai": "tra_loi_ngan",
  "de": "Cho $x^2+2y^2-2xy-2x+4y+2=0$\nTính giá trị biểu thức $A=(x-1)^{2025}+(y+1)^{2025}$",
  "dap_an": "-1",
  "loi_giai": "Ta có $x^2+2y^2-2xy-2x+4y+2=0$\n$(x^2+y^2+1-2xy-2x+2y)+(y^2+2y+1)=0$\n$(x-y-1)^2+(y+1)^2=0$\nMà $(x-y-1)^2 \\ge 0$; $(y+1)^2 \\ge 0 \\Rightarrow (x-y-1)^2+(y+1)^2 \\ge 0$\nDấu '=' xảy ra khi $(x-y-1)^2 = (y+1)^2 = 0 \\Rightarrow x=0; y=-1$\nKhi đó $A=(x-1)^{2025}+(y+1)^{2025}=(0-1)^{2025}+(-1+1)^{2025}=-1$"
 },
 {
  "ma_cau": "T108010402001",
  "loai": "tra_loi_ngan",
  "de": "Tính: $(4x^3y^2 + 8x^2y^2 - 7x^2y^3) : x^2y$",
