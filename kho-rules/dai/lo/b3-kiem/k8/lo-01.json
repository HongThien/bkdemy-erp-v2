 {
  "ma_cau": "T108030501001",
  "loai": "tra_loi_ngan",
  "de": "Phân tích đa thức $2x^3-x^2-13x-6$ thành nhân tử.",
  "dap_an": "$(x+2)(x-3)(2x+1)$",
  "loi_giai": "$2x^3-x^2-13x-6$\n$= 2x^3 + 4x^2 - 5x^2 - 10x - 3x - 6$\n$= 2x^2(x + 2) - 5x(x + 2) - 3(x + 2)$\n$= (x + 2)(2x^2 - 5x - 3)$\n$= (x + 2)(2x^2 + x - 6x - 3)$\n$= (x + 2)[x(2x + 1) - 3(2x + 1)]$\n$= (x + 2)(x - 3)(2x + 1)."
 },
 {
  "ma_cau": "T108030602049",
  "loai": "tra_loi_ngan",
  "de": "$x^2(x-3)+4(3-x)=0$",
  "dap_an": "-2; 2; 3",
  "loi_giai": "$x^2(x-3)+4(3-x)=0$\n$x^2(x-3)-4(x-3)=0$\n$(x-3)(x^2-4)=0$\nTrường hợp 1:\n$x-3=0$\n$x=3$\nTrường hợp 2:\n$x^2-4=0$\n$x^2=4$\n$x=\\pm2$\nVậy:\n$x=-2; x=2; x=3$"
 },
 {
